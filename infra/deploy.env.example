# OwnChart deploy target — sourced by infra/deploy.sh.
# Copy this file to infra/deploy.env (gitignored) and fill in your
# host. Both env-var and config-file styles are supported.

# SSH user on the deploy host.
OWNCHART_DEPLOY_USER=administrator

# Hostname or IP of the deploy host. NPM / Caddy / Traefik can sit
# in front and terminate TLS on a public name.
OWNCHART_DEPLOY_HOST=example.internal

# Optional. Default is /home/${OWNCHART_DEPLOY_USER}/ownchart.
# OWNCHART_DEPLOY_DIR=/srv/ownchart

# Public base URL the app should advertise. Must match what's
# registered with your EHR vendor (Epic, Athena, etc.).
OWNCHART_PUBLIC_BASE_URL=https://your-instance.example.com
