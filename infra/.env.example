# Copy to infra/.env on Maverick. NEVER commit infra/.env.
# infra/deploy.sh will refuse to deploy if any of the marked secrets are unset
# or still equal to the placeholder.

# --- Postgres ---------------------------------------------------------------
POSTGRES_USER=ownchart
POSTGRES_PASSWORD=CHANGE_ME_pg_password
POSTGRES_DB=ownchart

# --- API --------------------------------------------------------------------
# "dev" enables HTTP cookies and looser defaults. Use "prod" everywhere else.
OWNCHART_ENV=prod
# DANGER: enables raw payload logging — PHI may appear in logs.
OWNCHART_DEBUG_PAYLOADS=false

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=CHANGE_ME_session_secret

# --- Anthropic --------------------------------------------------------------
# Nick's dev key lives at OwnChart/anthropic_dev_key.txt (gitignored).
# infra/deploy.sh reads that file and writes it into infra/.env on Maverick.
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-opus-4-7
ANTHROPIC_VISION_MODEL=claude-opus-4-7

# --- EHR client IDs (SMART-on-FHIR) -----------------------------------------
# These are public client IDs (PKCE) — not secret in the cryptographic
# sense, but operator-specific. Set them per the user-docs/CONNECTORS.md
# pattern after registering your app with each vendor.
#
# Epic: single registration covers federated patient-app launches.
OWNCHART_EPIC_CLIENT_ID=
OWNCHART_EPIC_CLIENT_ID_SANDBOX=
# Athena: multi-tenant FHIR base, no MedicationRequest scope in V1.
OWNCHART_ATHENA_CLIENT_ID=
# ModMed: Drummond-certified FHIR R4. Per-practice fhir_base set in
# the connector row at create time (the client_id is the same across
# the operator's practices).
OWNCHART_MODMED_CLIENT_ID=
