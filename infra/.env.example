# Copy to infra/.env. NEVER commit infra/.env.
# The compose stack will refuse to start if any of POSTGRES_PASSWORD,
# SESSION_SECRET, or OWNCHART_TOKEN_DEK is unset or still equal to its
# CHANGE_ME placeholder.

# --- Postgres ---------------------------------------------------------------
POSTGRES_USER=ownchart
POSTGRES_PASSWORD=CHANGE_ME_pg_password
POSTGRES_DB=ownchart

# --- API --------------------------------------------------------------------
# "dev" enables HTTP cookies and looser defaults. Use "prod" everywhere else.
OWNCHART_ENV=prod
# DANGER: enables raw payload logging — PHI may appear in logs.
OWNCHART_DEBUG_PAYLOADS=false

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=CHANGE_ME_session_secret

# --- Anthropic --------------------------------------------------------------
# Default API key for LLM features. Leave blank to require users to set their
# own per-user keys via the /settings/providers UI (BYOK). See user-docs/PROMPTS.md
# for the prompt registry, and SECURITY.md §6 for provider-keying alternatives.
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-opus-4-7
ANTHROPIC_VISION_MODEL=claude-opus-4-7

# --- EHR client IDs (SMART-on-FHIR) -----------------------------------------
# These are public client IDs (PKCE) — not secret in the cryptographic
# sense, but operator-specific. Set them per the user-docs/CONNECTORS.md
# pattern after registering your app with each vendor.
#
# Epic: single registration covers federated patient-app launches.
OWNCHART_EPIC_CLIENT_ID=
OWNCHART_EPIC_CLIENT_ID_SANDBOX=
# Athena: multi-tenant FHIR base, no MedicationRequest scope in V1.
OWNCHART_ATHENA_CLIENT_ID=
# ModMed: Drummond-certified FHIR R4. Per-practice fhir_base set in
# the connector row at create time (the client_id is the same across
# the operator's practices).
OWNCHART_MODMED_CLIENT_ID=
# Cerner / Oracle Health Millennium: public client, no client secret.
# PKCE S256 mandatory. Get the client_id from code-console.cerner.com
# after registering a Patient app for FHIR R4. Same client_id works
# across every Cerner tenant (per-tenant fhir_base set in the
# connector row at create time).
OWNCHART_CERNER_CLIENT_ID=

# --- Google Calendar OAuth (Beta 1) ----------------------------------------
# Register an OAuth 2.0 Client ID of type "Web application" in Google Cloud.
# This is NOT a Google Calendar API key. See user-docs/GOOGLE_CALENDAR_SETUP.md.
#
# Authorized redirect URI in Google Cloud must exactly match:
#   https://<your-host>/settings/calendar/google/callback
OWNCHART_GOOGLE_CALENDAR_CLIENT_ID=
OWNCHART_GOOGLE_CALENDAR_CLIENT_SECRET=
OWNCHART_GOOGLE_CALENDAR_REDIRECT_URI=
