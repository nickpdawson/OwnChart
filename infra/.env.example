# Copy to infra/.env on Maverick. NEVER commit infra/.env.
# infra/deploy.sh will refuse to deploy if any of the marked secrets are unset
# or still equal to the placeholder.

# --- Postgres ---------------------------------------------------------------
POSTGRES_USER=ownchart
POSTGRES_PASSWORD=CHANGE_ME_pg_password
POSTGRES_DB=ownchart

# --- API --------------------------------------------------------------------
# "dev" enables HTTP cookies and looser defaults. Use "prod" everywhere else.
OWNCHART_ENV=prod
# DANGER: enables raw payload logging — PHI may appear in logs.
OWNCHART_DEBUG_PAYLOADS=false

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=CHANGE_ME_session_secret

# --- Anthropic --------------------------------------------------------------
# Nick's dev key lives at OwnChart/anthropic_dev_key.txt (gitignored).
# infra/deploy.sh reads that file and writes it into infra/.env on Maverick.
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-opus-4-7
ANTHROPIC_VISION_MODEL=claude-opus-4-7
