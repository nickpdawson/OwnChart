# ============================================================================
# OwnChart .gitignore
# ----------------------------------------------------------------------------
# Doctrine: PHI lives on disk, never in git. Secrets live in env vars, never
# in git. When in doubt, exclude. The public repo is a publication of code,
# never of the patient's record.
# ============================================================================

# ---- Runtime data ----------------------------------------------------------
# PHI bind-mount target. The actual record (PDFs, images, OCR text, payloads)
# lives here. Never commit.
data/
*.sqlite
*.sqlite3

# ---- Secrets ---------------------------------------------------------------
.env
.env.*
!.env.example
infra/.env
# Per-instance app config (template tracked as infra/config.example.yaml)
infra/config.yaml
# Anthropic / LLM keys
anthropic_dev_key.txt
anthropic_*_key.txt
*.key.txt
*_secret.txt
secrets/
# Generic credential file patterns
*.pem
*.key
*.p12
*.pfx
*.cer
*.crt
# Keep example certs if any future contributor adds them under a clearly
# marked path:
!**/example*.pem
!**/example*.crt

# ---- PHI / patient artifacts -----------------------------------------------
# HAR captures contain auth cookies, OAuth tokens, and frequently the full
# payload of clinical API responses. NEVER commit.
*.har
*.har.gz

# Patient-record file types people sometimes drop in the repo by accident.
# Real evidence belongs under data/ (gitignored above) or in the user's
# bind-mount, NOT in source control.
*.ccda
*.ccd
*.cda
*.dcm           # DICOM images
*.dicom
# Common medical-record exports
*export*.zip
*export*.tar.gz
*MyChart*
*HealthSummary*

# Loose images/PDFs at repo root are almost always accidental paste-from-Photos
/IMG_*.jpg
/IMG_*.jpeg
/IMG_*.png
/IMG_*.heic
/IMG_*.tiff
/IMG_*.pdf
/Scan*.pdf
/scan*.pdf

# ---- Internal working docs (not for the public repo) -----------------------
# The full requirements packet lives in Nick's working tree but is not
# published. The public docs live under user-docs/ (which IS tracked).
docs/
MORNING_QUESTIONS.md
OPEN_QUESTIONS.md
DEVELOPMENT_LOG.md

# Reverse-engineering notes on third-party patient portals — internal only.
KP_API.md

# Private skill / methodology drafts
CAHL_SKILL.md

# ---- iOS app (shipping later) ----------------------------------------------
OwnChartiOS/

# Xcode boilerplate — defensive, in case iOS code lands later
*.xcuserstate
*.xcuserdatad/
xcuserdata/
DerivedData/
*.xcscmblueprint
*.xccheckout
*.moved-aside

# ---- Local agent / tooling configs -----------------------------------------
.agents/
.claude/
.codex/
.stfolder/
skills-lock.json
# Claude Code per-user settings (project-shared lives under .claude/, also ignored above)
.claude/settings.local.json

# ---- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---- Node / Next.js --------------------------------------------------------
node_modules/
.next/
out/
.turbo/
.next-build/
*.tsbuildinfo
next-env.d.ts

# ---- OS / editor -----------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# ---- Google Drive sync conflict artifacts ----------------------------------
# The Drive client creates "<name> 2.<ext>" duplicates on conflict. Never the
# file we want.
* 2.md
* 2.txt
* 2.json
* 2.yaml
* 2.png
* 2.jpg
* 2.jpeg
* 2.pdf
* copy.md
* copy.txt
* copy.json
* copy.yaml

# ---- Logs / build artifacts ------------------------------------------------
*.log
logs/
dist/
build/
.docker-volumes/

# ---- Generated design tokens (regenerated by the design skill) -------------
web/styles/tokens.generated.css
infra/deploy.env

# Demo deployment state — never tracked.
infra/.env.demo
data-demo/
infra/demo_data/sample_patient.json
infra/demo_data/*.json
